cc_library_shared {
    name: "libStDrvInt",

    vendor: true,
    compile_multilib: "64",

    srcs: [
        "StDrvInt.c",
    ],

    shared_libs: [
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",



        "-mno-outline-atomics",
    ],

    stl: "none",
}
