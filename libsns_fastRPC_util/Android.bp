cc_library_shared {
    name: "libsns_fastRPC_util",

    vendor: true,
    compile_multilib: "64",

    srcs: [
        "libsns_fastRPC_util.c",
    ],

    local_include_dirs: [
        "include",
    ],

    shared_libs: [
        "liblog",
        "libdl",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",
    ],

    stl: "none",
}
