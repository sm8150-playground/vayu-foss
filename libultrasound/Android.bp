cc_library_shared {
    name: "libultrasound",

    vendor: true,
    compile_multilib: "64",

    srcs: [
        "ultrasound.c",
    ],

    local_include_dirs: [
        "include",
    ],

    shared_libs: [
        "libcutils",
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",
    ],

    stl: "none",
}
