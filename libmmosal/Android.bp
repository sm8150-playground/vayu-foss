cc_library_shared {
    name: "libmmosal",

    vendor: true,
    compile_multilib: "both",

    srcs: [
        "mmosal.c",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",




        "-fsemantic-interposition",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
    ],

    stl: "none",
}
