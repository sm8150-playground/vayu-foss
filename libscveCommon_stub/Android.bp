cc_library_shared {
    name: "libscveCommon_stub",

    vendor: true,
    compile_multilib: "both",

    srcs: [
        "scve_common_stub.c",
    ],

    local_include_dirs: [
        "include",
    ],

    shared_libs: [
        "libcdsprpc",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",
    ],

    stl: "none",
}
