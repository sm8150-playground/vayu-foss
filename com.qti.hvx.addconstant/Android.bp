cc_library_shared {
    name: "com.qti.hvx.addconstant",

    vendor: true,
    compile_multilib: "64",

    relative_install_path: "camera/components",

    srcs: [
        "addconstant.cpp",
    ],

    local_include_dirs: [
        "include",
    ],

    shared_libs: [
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",
    ],

    stl: "none",
}
