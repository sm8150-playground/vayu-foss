cc_library_shared {
    name: "libresampler",

    vendor: true,
    compile_multilib: "32",

    srcs: [
        "libresampler.c",
    ],

    shared_libs: [
        "liblog",
        "libm",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",


        "-mthumb",





        "-ffp-contract=off",
    ],

    stl: "none",
}
