cc_library_shared {
    name: "libtinyxml2_1",

    vendor: true,
    compile_multilib: "64",

    srcs: [
        "tinyxml2.cpp",
    ],

    local_include_dirs: [
        "include",
    ],
    export_include_dirs: [
        "include",
    ],







    cflags: [
        "-Wall",


        "-fvisibility-inlines-hidden",

        "-fno-exceptions",
    ],



    rtti: false,



    stl: "c++_shared",
}
