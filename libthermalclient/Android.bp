cc_library_shared {
    name: "libthermalclient",

    vendor: true,
    compile_multilib: "both",

    srcs: [
        "libthermalclient.c",
    ],

    cflags: [
        "-Wall",
        "-Wextra",









        "-fsemantic-interposition",
    ],

    shared_libs: [
        "liblog",
    ],

    stl: "none",
}
