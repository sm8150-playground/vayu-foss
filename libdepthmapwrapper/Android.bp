cc_library_shared {
    name: "libdepthmapwrapper",

    vendor: true,


    relative_install_path: "camera/components",
    compile_multilib: "64",

    srcs: [
        "depthmapwrapper.c",
    ],

    local_include_dirs: [
        "include",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",
    ],

    stl: "none",
}
