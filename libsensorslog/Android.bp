cc_library_shared {
    name: "libsensorslog",

    vendor: true,
    compile_multilib: "64",

    srcs: [
        "libsensorslog.cpp",
    ],

    local_include_dirs: [
        "include",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",
    ],

    stl: "none",
}
