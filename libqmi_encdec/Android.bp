cc_library_shared {
    name: "libqmi_encdec",

    vendor: true,
    compile_multilib: "64",

    srcs: [
        "libqmi_encdec.c",
    ],

    cflags: [
        "-Wall",
        "-Wextra",



        "-fvisibility=hidden",




        "-fsemantic-interposition",
    ],

    stl: "none",
}
